senha_correta = "1234"
tentativas = 0
acesso = False

while tentativas < 3:
    senha = input("Digite sua senha: ")

    if senha == senha_correta:
        print("Acesso autorizado!")
        acesso = True
        break
    else:
        tentativas += 1
        print("Senha incorreta!")

        if tentativas < 3:
            print("Tentativas restantes:", 3 - tentativas)

else :
    print("Acesso bloqueado. Você excedeu o número de tentativas.")
