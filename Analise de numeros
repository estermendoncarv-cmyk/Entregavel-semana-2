programa
{
    funcao inicio()
    {
        real numero, soma, media, maior, menor
        inteiro i

        soma = 0

        para (i = 1; i <= 5; i++)
        {
            escreva("Digite o ", i, "º número: ")
            leia(numero)

            soma = soma + numero

            se (i == 1)
            {
                maior = numero
                menor = numero
            }
            senao
            {
                se (numero > maior)
                {
                    maior = numero
                }

                se (numero < menor)
                {
                    menor = numero
                }
            }
        }

        media = soma / 5

        escreva("\n===== RESULTADOS =====\n")
        escreva("Soma: ", soma, "\n")
        escreva("Média: ", media, "\n")
        escreva("Maior número: ", maior, "\n")
        escreva("Menor número: ", menor, "\n")
    }
}
